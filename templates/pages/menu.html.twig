{% extends 'base.html.twig' %}

{% block title %}La Carte - O'Trari{% endblock %}

{% block body %}
<div class="min-h-screen font-body bg-pieza-cream">
    {% include 'partials/_header.html.twig' %}

    <main class="py-12 px-6">
        <div class="max-w-7xl mx-auto">
            {# Hero Section #}
            <div class="mb-12 text-center">
                <h1 class="font-display text-5xl md:text-7xl text-pieza-green mb-4">
                    LA <span class="text-pieza-orange">CARTE</span>
                </h1>
                <p class="font-body text-lg text-pieza-green/70 max-w-2xl mx-auto">
                    Découvrez notre sélection complète : pizzas artisanales, pâtes fraîches, desserts gourmands et boissons rafraîchissantes.
                </p>
            </div>

            {# Category Pills #}
            <div class="flex flex-wrap justify-center gap-3 mb-8">
                <a 
                    href="{{ path('app_menu') }}" 
                    class="px-6 py-3 rounded-full font-body font-semibold transition-all {{ activeCategory is null ? 'bg-pieza-green text-pieza-cream' : 'bg-white border-2 border-pieza-green text-pieza-green hover:bg-pieza-green hover:text-pieza-cream' }}"
                    data-action="click->navigation-feedback#onFilterClick"
                >
                    Tout
                </a>
                {% for catKey, catLabel in categories %}
                    {% if catKey in activeCategories %}
                    <a 
                        href="{{ path('app_menu', {category: catKey}) }}" 
                        class="px-6 py-3 rounded-full font-body font-semibold transition-all flex items-center gap-2 {{ activeCategory == catKey ? 'bg-pieza-green text-pieza-cream' : 'bg-white border-2 border-pieza-green text-pieza-green hover:bg-pieza-green hover:text-pieza-cream' }}"
                        data-action="click->navigation-feedback#onFilterClick"
                    >
                        {% if catKey == 'pizza' %}🍕{% endif %}
                        {% if catKey == 'pates' %}🍝{% endif %}
                        {% if catKey == 'dessert' %}🍰{% endif %}
                        {% if catKey == 'boisson' %}🥤{% endif %}
                        {{ catLabel }}
                    </a>
                    {% endif %}
                {% endfor %}
            </div>

            {# Context-specific Filters (only when category is selected) #}
            {% if activeCategory and filters|length > 0 %}
            <div class="flex flex-wrap justify-center gap-2 mb-8" data-testid="sub-filters">
                <a 
                    href="{{ path('app_menu', {category: activeCategory}) }}" 
                    class="px-4 py-2 rounded-full font-body text-sm transition-all {{ activeFilter is null ? 'bg-pieza-orange text-pieza-cream' : 'bg-pieza-orange/20 text-pieza-orange hover:bg-pieza-orange/40' }}"
                    data-action="click->navigation-feedback#onFilterClick"
                >
                    Tous
                </a>
                {% for filterKey, filterLabel in filters %}
                <a 
                    href="{{ path('app_menu', {category: activeCategory, filter: filterKey}) }}" 
                    class="px-4 py-2 rounded-full font-body text-sm transition-all {{ activeFilter == filterKey ? 'bg-pieza-orange text-pieza-cream' : 'bg-pieza-orange/20 text-pieza-orange hover:bg-pieza-orange/40' }}"
                    data-action="click->navigation-feedback#onFilterClick"
                >
                    {{ filterLabel }}
                </a>
                {% endfor %}
            </div>
            {% endif %}

            {# Skeleton Loader — shown during Turbo navigation #}
            <div data-navigation-feedback-target="skeleton" class="hidden">
                <div class="turbo-progress-bar"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
                    {% for i in 1..8 %}
                    <div class="skeleton-pulse p-6 h-80 rounded-3xl">
                        <div class="w-32 h-32 mx-auto rounded-full bg-pieza-green/5 mb-6"></div>
                        <div class="h-6 bg-pieza-green/5 rounded-full w-3/4 mx-auto mb-3"></div>
                        <div class="h-4 bg-pieza-green/5 rounded-full w-1/2 mx-auto mb-2"></div>
                        <div class="h-4 bg-pieza-green/5 rounded-full w-2/3 mx-auto"></div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Dietary Filters #}
            {% if availableDiets|length > 0 %}
            <div class="flex flex-wrap justify-center items-center gap-2 mb-8">
                {% for dietKey, diet in availableDiets %}
                    {% set isActive = dietKey in activeRegimes %}
                    {# Toggle: add or remove this diet #}
                    {% if isActive %}
                        {% set newRegimes = activeRegimes|filter(v => v != dietKey) %}
                    {% else %}
                        {% set newRegimes = activeRegimes|merge([dietKey]) %}
                    {% endif %}
                    {# Build query params preserving other filters #}
                    {% set params = {} %}
                    {% if activeCategory %}{% set params = params|merge({category: activeCategory}) %}{% endif %}
                    {% if activeFilter %}{% set params = params|merge({filter: activeFilter}) %}{% endif %}
                    {% for s in activeSans %}
                        {% set params = params|merge({('sans[' ~ loop.index0 ~ ']'): s}) %}
                    {% endfor %}
                    {% for r in newRegimes %}
                        {% set params = params|merge({('regime[' ~ loop.index0 ~ ']'): r}) %}
                    {% endfor %}
                    <a 
                        href="{{ path('app_menu', params) }}"
                        class="px-4 py-2 rounded-full font-body text-sm transition-all {{ isActive ? 'bg-pieza-orange text-pieza-cream' : 'bg-pieza-orange/20 text-pieza-orange hover:bg-pieza-orange/40' }}"
                    >
                        {{ diet.emoji }} {{ diet.label }}
                    </a>
                {% endfor %}
            </div>
            {% endif %}

            {# Allergen Exclusion Filters #}
            {% if availableAllergens|length > 0 %}
            <div class="flex flex-wrap justify-center items-center gap-2 mb-8">
                {% for allergenKey, allergenLabel in availableAllergens %}
                    {% set isActive = allergenKey in activeSans %}
                    {# Build the new sans array: toggle the current allergen #}
                    {% if isActive %}
                        {% set newSans = activeSans|filter(v => v != allergenKey) %}
                    {% else %}
                        {% set newSans = activeSans|merge([allergenKey]) %}
                    {% endif %}
                    {# Build query params preserving other filters #}
                    {% set params = {} %}
                    {% if activeCategory %}{% set params = params|merge({category: activeCategory}) %}{% endif %}
                    {% if activeFilter %}{% set params = params|merge({filter: activeFilter}) %}{% endif %}
                    {% for s in newSans %}
                        {% set params = params|merge({('sans[' ~ loop.index0 ~ ']'): s}) %}
                    {% endfor %}
                    {% for r in activeRegimes %}
                        {% set params = params|merge({('regime[' ~ loop.index0 ~ ']'): r}) %}
                    {% endfor %}
                    <a href="{{ path('app_menu', params) }}" class="px-4 py-2 rounded-full font-body text-sm transition-all {{ isActive ? 'bg-pieza-orange text-pieza-cream' : 'bg-pieza-orange/20 text-pieza-orange hover:bg-pieza-orange/40' }}">
                        Sans {{ allergenLabel }}
                    </a>
                {% endfor %}
            </div>
            {% endif %}

            {# Products Display - Grouped by Category #}
            <div data-navigation-feedback-target="content">
            {% if productsByCategory|length > 0 %}
                {% for catKey, catProducts in productsByCategory %}
                    {% if catProducts|length > 0 %}
                    <section class="mb-16">
                        <div class="flex items-center gap-4 mb-8">
                            <span class="text-4xl">
                                {% if catKey == 'pizza' %}🍕{% endif %}
                                {% if catKey == 'pates' %}🍝{% endif %}
                                {% if catKey == 'dessert' %}🍰{% endif %}
                                {% if catKey == 'boisson' %}🥤{% endif %}
                            </span>
                            <h2 class="font-display text-3xl md:text-4xl text-pieza-green">
                                {{ categories[catKey]|default(catKey|capitalize) }}
                            </h2>
                            <div class="flex-1 h-0.5 bg-pieza-green/20 rounded-full"></div>
                            <span class="font-body text-pieza-green/60">{{ catProducts|length }} produit{{ catProducts|length > 1 ? 's' : '' }}</span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                            {% for product in catProducts %}
                                {{ include('partials/_product_card.html.twig', {product: product}) }}
                            {% endfor %}
                        </div>
                    </section>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="text-center py-16">
                    <span class="text-6xl mb-4 block">🍽️</span>
                    <h3 class="font-display text-2xl text-pieza-green mb-2">Aucun produit trouvé</h3>
                    <p class="font-body text-pieza-green/70 mb-6">Essayez de modifier vos critères de recherche.</p>
                    <a href="{{ path('app_menu') }}" class="inline-block bg-pieza-orange text-pieza-cream px-6 py-3 rounded-full font-body font-semibold hover:bg-pieza-green transition-colors">
                        Voir toute la carte
                    </a>
                </div>
            {% endif %}
            </div>
        </div>
    </main>

    {% include 'partials/_footer.html.twig' %}
</div>
{% endblock %}
