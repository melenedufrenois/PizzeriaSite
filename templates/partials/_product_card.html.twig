<div class="bg-pieza-cream border-2 border-pieza-green rounded-3xl p-6 relative hover:shadow-xl transition-shadow duration-300 group">
    {% if product.isPopular() %}
    <div class="absolute -top-3 -right-3 bg-pieza-orange text-pieza-cream font-body font-semibold text-xs px-4 py-2 rounded-full rotate-12 z-10">
        Populaire
    </div>
    {% endif %}

    {# Category Badge for Pizza base #}
    <div class="absolute top-4 left-4 z-10 flex gap-2">
        {% if product.getCategory() == 'pizza' and product.getBase is defined %}
        <span class="bg-white/90 backdrop-blur-sm text-pieza-green font-body text-xs px-3 py-1 rounded-full border border-pieza-green/30">
            {{ product.getBase() == 'tomate' ? '🍅 Tomate' : '🥛 Crème' }}
        </span>
        {% endif %}
        {% if product.getCategory() == 'boisson' and product.getVolume is defined and product.getVolume() %}
        <span class="bg-white/90 backdrop-blur-sm text-pieza-green font-body text-xs px-3 py-1 rounded-full border border-pieza-green/30">
            {{ product.getVolume() }}
        </span>
        {% endif %}
    </div>

    <div class="mb-6 relative overflow-hidden rounded-full">
        <img
            src="{{ product.getImage() }}"
            alt="{{ product.getName() }}"
            class="w-full aspect-square object-cover rounded-full group-hover:scale-105 transition-transform duration-300"
        />
    </div>

    <h3 class="font-display text-2xl text-pieza-green mb-2">
        {{ product.getName() }}
    </h3>

    {# Type and Allergens #}
    {% if product.getType() or product.getAllergens()|length > 0 %}
    <div class="flex flex-wrap items-center gap-2 mb-3">
        {% if product.getType() %}
        <span class="inline-block bg-pieza-green/10 text-pieza-green font-body text-xs px-3 py-1 rounded-full capitalize">
            {{ product.getType() }}
        </span>
        {% endif %}

        {% if product.getAllergens()|length > 0 %}
        <div class="relative inline-flex">
            <button
                type="button"
                class="peer inline-flex items-center gap-2 rounded-full border border-pieza-orange/20 bg-pieza-orange/10 px-3 py-1 font-body text-xs font-semibold text-pieza-orange cursor-help"
            >
                Allergènes
                <span class="flex h-4 w-4 items-center justify-center rounded-full bg-pieza-orange text-[10px] text-pieza-cream">
                    i
                </span>
            </button>
            <div class="pointer-events-none absolute left-0 top-full z-20 mt-2 w-56 rounded-2xl border border-pieza-orange/20 bg-white/95 p-3 font-body text-xs leading-relaxed text-pieza-green shadow-lg opacity-0 transition-opacity duration-200 peer-hover:opacity-100 peer-focus:opacity-100">
                {{ product.getAllergens()|join(', ') }}
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {# Description or Ingredients #}
    {% if product.getDescription() %}
    <div class="mb-4">
        <p class="font-body text-sm text-pieza-green/70 line-clamp-2">
            {{ product.getDescription() }}
        </p>
    </div>
    {% elseif product.getIngredients is defined and product.getIngredients()|length > 0 %}
    <div class="mb-4">
        <p class="font-body text-sm text-pieza-green/70">
            {{ product.getIngredients()|join(', ') }}
        </p>
    </div>
    {% endif %}

    {# Price #}
    <div class="flex items-center justify-between mt-auto pt-4 border-t border-pieza-green/20">
        <span class="font-display text-2xl text-pieza-orange">{{ product.getPrice()|number_format(2, ',', ' ') }}€</span>
    </div>
</div>
