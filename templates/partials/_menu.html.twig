<section id="menu" class="bg-pieza-cream py-24 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="mb-16">
            <h2 class="font-display text-5xl md:text-7xl text-pieza-green mb-4">
                BEST <span class="text-pieza-orange">OF</span>
                <br>
                THE BEST
            </h2>
            <p class="font-body text-lg text-pieza-green/70 max-w-xl">
                We believe that every pizza deserves a deliciously cheesy crust, and
                that's why we made it our mission to create the cheesiest, most
                indulgent pizzas around.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% for pizza in pizzas %}
            <div class="bg-pieza-cream border-2 border-pieza-green rounded-3xl p-6 relative">
                {% if pizza.popular is defined and pizza.popular %}
                <div class="absolute -top-3 -right-3 bg-pieza-orange text-pieza-cream font-body font-semibold text-xs px-4 py-2 rounded-full rotate-12">
                    Popular
                </div>
                {% endif %}

                <div class="mb-6 relative">
                    <img
                        src="{{ pizza.image }}"
                        alt="{{ pizza.name }}"
                        class="w-full aspect-square object-cover rounded-full"
                    />
                </div>

                <h3 class="font-display text-2xl text-pieza-green mb-4">
                    {{ pizza.name }}
                </h3>

                <div class="flex items-center justify-between gap-2 mb-4">
                    <button type="button" class="w-10 h-10 rounded-full border-2 border-pieza-green flex items-center justify-center hover:bg-pieza-green hover:text-pieza-cream transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                    <span class="font-body font-semibold text-pieza-green text-xl quantity-display">0</span>
                    <button type="button" class="w-10 h-10 rounded-full border-2 border-pieza-green flex items-center justify-center hover:bg-pieza-green hover:text-pieza-cream transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                </div>

                <button type="button" class="w-full bg-pieza-green text-pieza-cream py-3 rounded-full font-body font-semibold hover:bg-pieza-orange transition-colors">
                    Add to cart · ${{ pizza.price }}
                </button>
            </div>
            {% endfor %}
        </div>

        <div class="text-center mt-12">
            <button type="button" class="text-pieza-green font-body font-semibold text-lg underline hover:text-pieza-orange transition-colors">
                See All Pizzas
            </button>
        </div>
    </div>
</section>
