{% extends 'base.html.twig' %}

{% block title %}Notre Carte – Pizzeria O'Trari{% endblock %}

{% block body %}
<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title">Notre Carte 🍕</h1>
        <p class="page-hero__subtitle">Des pizzas artisanales pour tous les goûts</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="section__header">
            <h2 class="section__title">Nos Pizzas</h2>
            <p class="section__subtitle">Toutes nos pizzas sont préparées à la commande avec une pâte maison fermentée 48h.</p>
        </div>
        <div class="card-grid">
            {% for pizza in pizzas %}
            <div class="card">
                <div class="card__emoji">{{ pizza.emoji }}</div>
                <div class="card__body">
                    <h3 class="card__title">{{ pizza.name }}</h3>
                    <p class="card__desc">{{ pizza.desc }}</p>
                    <span class="card__price">{{ pizza.price }}</span>
                    {% if pizza.badge %}
                    <span class="card__badge">{{ pizza.badge }}</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="section" style="background-color: var(--color-bg-alt);">
    <div class="container" style="text-align: center;">
        <h2 class="section__title" style="margin-bottom: 1rem;">Vous avez faim ?</h2>
        <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">Passez commande par téléphone ou venez nous rendre visite !</p>
        <a href="{{ path('contact') }}" class="btn btn--accent">Nous contacter</a>
    </div>
</section>
{% endblock %}
