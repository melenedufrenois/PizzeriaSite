<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Pizzeria{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍕</text></svg>" type="image/svg+xml">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#main-content">Aller au contenu principal</a>

        <header role="banner">
            {% block header %}{% endblock %}
        </header>

        <nav aria-label="Navigation principale">
            {% block nav %}{% endblock %}
        </nav>

        <main id="main-content" tabindex="-1">
            {% block body %}{% endblock %}
        </main>

        <footer role="contentinfo">
            {% block footer %}{% endblock %}
        </footer>
    </body>
</html>
