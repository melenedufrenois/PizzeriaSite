<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}O'Trari - Pizzeria{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍕</text></svg>">
        <meta property="og:image" content="https://bolt.new/static/og_default.png">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:image" content="https://bolt.new/static/og_default.png">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        {# Apply saved theme early to avoid flash of wrong theme #}
        <script>
            (function () {
                var savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'dark' || savedTheme === 'light') {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                }
            }());
        </script>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen font-body antialiased" data-controller="navigation-feedback">
        {# Data-saver toggle: lets users opt in/out of bandwidth-saving mode. #}
        <button type="button"
                class="data-saver-toggle"
                data-controller="responsive-image"
                data-action="click->responsive-image#toggleSaveData"
                title="{{ save_data|default(false) ? 'Désactiver' : 'Activer' }} le mode Économie de données"
                aria-pressed="{{ save_data|default(false) ? 'true' : 'false' }}">
            🔋 {{ save_data|default(false) ? 'Économie de données : ON' : 'Économie de données : OFF' }}
        </button>

        {% block body %}{% endblock %}
    </body>
</html>
