{% extends 'base.html.twig' %}

{% block title %}Contact – Pizzeria O'Trari{% endblock %}

{% block body %}
<div class="page-hero">
    <div class="container">
        <h1 class="page-hero__title">Contact 📍</h1>
        <p class="page-hero__subtitle">Nous sommes disponibles pour répondre à vos questions</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info">
                <h2>Nous trouver</h2>
                <p>Venez nous rendre visite ou commandez par téléphone. Nous livrons dans un rayon de 5 km.</p>

                <div class="contact-detail">
                    <span class="contact-detail__icon">📍</span>
                    <div>
                        <strong>Adresse</strong><br>
                        12 rue des Oliviers<br>
                        75000 Paris
                    </div>
                </div>

                <div class="contact-detail">
                    <span class="contact-detail__icon">📞</span>
                    <div>
                        <strong>Téléphone</strong><br>
                        <a href="tel:+33123456789" style="color: var(--color-primary);">01 23 45 67 89</a>
                    </div>
                </div>

                <div class="contact-detail">
                    <span class="contact-detail__icon">✉️</span>
                    <div>
                        <strong>Email</strong><br>
                        <a href="mailto:contact@otrari.fr" style="color: var(--color-primary);">contact@otrari.fr</a>
                    </div>
                </div>

                <div class="contact-detail">
                    <span class="contact-detail__icon">🕐</span>
                    <div>
                        <strong>Horaires</strong><br>
                        Lun–Ven : 11h30 – 14h30 / 18h00 – 22h00<br>
                        Sam–Dim : 11h30 – 23h00
                    </div>
                </div>
            </div>

            <div>
                <h2 style="font-size: var(--font-size-xl); font-weight: 700; color: var(--color-dark); margin-bottom: var(--spacing-md);">Envoyez-nous un message</h2>
                <form class="form" action="{{ path('contact') }}" method="post" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="contact_name">Nom complet</label>
                        <input class="form-control" type="text" id="contact_name" name="name" placeholder="Votre nom" required autocomplete="name">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="contact_email">Adresse e-mail</label>
                        <input class="form-control" type="email" id="contact_email" name="email" placeholder="votre@email.fr" required autocomplete="email">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="contact_subject">Sujet</label>
                        <input class="form-control" type="text" id="contact_subject" name="subject" placeholder="Objet de votre message">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="contact_message">Message</label>
                        <textarea class="form-control" id="contact_message" name="message" placeholder="Votre message..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn--accent">Envoyer le message</button>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
