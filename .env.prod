###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
###< symfony/framework-bundle ###

###> symfony/mailer ###
# Production SMTP (example): smtp://user:password@smtp.provider.tld:587
MAILER_DSN=smtp://change-me:change-me@smtp.example.com:587
###< symfony/mailer ###

###> app/contact ###
CONTACT_DEFAULT_RECIPIENT=contact@your-domain.tld
CONTACT_SENDER_EMAIL=no-reply@your-domain.tld
###< app/contact ###
